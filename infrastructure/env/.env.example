# Copy to infrastructure/env/.env for local Compose (never commit .env)

# --- Postgres (pgvector) ---
POSTGRES_USER=crewpulse
POSTGRES_PASSWORD=crewpulse_dev_change_me
POSTGRES_DB=crewpulse
POSTGRES_HOST=localhost
# Host port (avoid clash with other local stacks on 5432/5433)
POSTGRES_PORT=15434
# Host-run services use localhost; Compose overrides to postgres:5432 inside containers
DATABASE_URL=postgresql://crewpulse:crewpulse_dev_change_me@localhost:15434/crewpulse

# --- Redis / BullMQ ---
REDIS_HOST=localhost
# Host port (avoid clash with other local stacks on 6379)
REDIS_PORT=16379
# Host-run services use localhost; Compose overrides to redis:6379 inside containers
REDIS_URL=redis://localhost:16379

# --- api-gateway (NestJS) ---
API_GATEWAY_PORT=3000
API_GATEWAY_HOST=0.0.0.0
NODE_ENV=development
# Comma-separated origins allowed to call the gateway from a browser (Vite SPA)
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# --- vision-engine (FastAPI) ---
VISION_ENGINE_PORT=8000
VISION_ENGINE_HOST=0.0.0.0
# Host-run / browser; Compose sets VISION_ENGINE_URL to http://vision-engine:8000 for api-gateway
VISION_ENGINE_URL=http://localhost:8000
# true = stub detect/match (default in Compose); false = load RetinaFace/Facenet weights
VISION_STUB=true
# Optional: bind-mount host DeepFace cache when VISION_STUB=false (see infrastructure/README.md)
# DEEPFACE_HOST_DIR=/home/ayman-wsl/.deepface

# --- worker-node ---
WORKER_NODE_PORT=3001

# --- Match / quality (placeholders; tune in later phases) ---
FACE_MATCH_THRESHOLD=0.85
FACE_MIN_SIZE_PX=80
# Vision quality gates (reject before embed; see infrastructure/docs/station-lighting-sop.md)
FACE_MAX_BLUR=0.65
FACE_MIN_LUMINANCE=0.15
FACE_MAX_LUMINANCE=0.92
# Passive PAD before embed (print/replay heuristics until a real model ships)
PAD_ENABLED=true
PAD_MIN_SCORE=0.45
# Heavy PPE/mask occlusion → assisted PIN/QR (not silent false reject)
OCCLUSION_ENABLED=true
OCCLUSION_MAX_SCORE=0.55
ATTENDANCE_COOLDOWN_SECONDS=60
# Assisted check-in credentials (change outside local/dev)
ASSISTED_SUPERVISOR_PIN=dev-pin-change-me
ASSISTED_QR_TOKENS=dev-qr-change-me

# --- Optional future ---
# KAFKA_BROKERS=localhost:9092

# --- Nginx (optional profile: edge) ---
NGINX_PORT=8080
